{
  "_comment": "This is the safe-to-commit template. install.sh renders this to ~/.claude/settings.json with ${ENV_VAR} placeholders replaced by current environment values. NEVER commit a version of this file containing literal secret values.",

  "model": "claude-opus-4-7",

  "env": {
    "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}"
  },

  "permissions": {
    "_comment": "Add allowed Bash commands and MCP tools here as you decide them. Start narrow and expand.",
    "allow": [
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": []
  },

  "hooks": {
    "_comment": "Hooks are scripts run automatically on events. Symlinked into ~/.claude/hooks/ by install.sh. Reference them here by name only after they exist in hooks/.",
    "SessionStart": [],
    "SessionStop": [],
    "PostToolUse": []
  }
}
