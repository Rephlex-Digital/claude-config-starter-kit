# Environment variables consumed by settings.json.template
# Copy this file to .env (gitignored), fill in real values, then source it from
# your shell init file (~/.zshrc on macOS, ~/.bashrc on Linux/WSL2, ~/.bash_profile on Git Bash).
#
# Or set these variables system-wide via your OS env-var settings.
#
# NEVER commit a .env file containing real secret values.

# Anthropic API key for Claude Code (only needed if not authenticated via OAuth)
ANTHROPIC_API_KEY=

# Add additional API keys as you wire up integrations:
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# (etc.)
